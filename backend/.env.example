# SQL Server (servidor propio)
DATABASE_URL="sqlserver://HOST:1433;database=CarteleriaDigital;user=USER;password=PASSWORD;encrypt=true;trustServerCertificate=false"

PORT=4000

# Auth de usuarios del panel admin
JWT_SECRET="changeme-user-secret"
JWT_EXPIRES_IN="8h"

# Auth de pantallas (token de larga duración emitido al emparejar)
SCREEN_TOKEN_SECRET="changeme-screen-secret"

# Azure Blob Storage (media: fotos/videos)
AZURE_STORAGE_CONNECTION_STRING=""
AZURE_STORAGE_CONTAINER="media"
SAS_URL_EXPIRY_MINUTES=60
